# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
# 虚拟环境
.venv/
venv/
env/

# 构建产物
build/
dist/
*.whl

# 测试与缓存
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# 编辑器
*.swp
*.pm
*.bak
.idea/
# 忽略 .vscode 下的内容，但放行 launch.json。
# 注意：不能写“.vscode/”（整目录），否则 ! 例外不生效——
# git 不会进入被忽略的目录去找例外。
.vscode/*
!.vscode/launch.json

# 本地运行数据
issues/
demo-notes/
demo-project/
.pdm.local.json

# 开发过程数据（笔记/feat/设计文档）：默认不跟踪、不随代码分发。
# 注意：.pdm.json（配置）仍跟踪，与本目录不同名不同层级。
.pdm/
