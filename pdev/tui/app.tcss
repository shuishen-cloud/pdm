Screen {
    layout: vertical;
}

#main {
    height: 1fr;
}

CommitList {
    width: 32;
    border: round $primary;
    border-title-color: $accent;
    background: $surface;
}

NoteList {
    width: 40;
    border: round $primary;
    border-title-color: $accent;
    background: $surface;
}

DetailPane {
    width: 1fr;
    border: round $primary;
    border-title-color: $accent;
    background: $surface;
    padding: 0 1;
}

ListView:focus {
    border: round $accent;
}

ListItem {
    padding: 0 1;
}

ListItem.--highlight {
    background: $accent 30%;
}

#detail-body {
    width: 1fr;
}

/* 放大：被选中的面板占满宽度，其余隐藏 */
CommitList.zoomed,
NoteList.zoomed,
DetailPane.zoomed {
    width: 1fr;
}

CommitList.dimmed,
NoteList.dimmed,
DetailPane.dimmed {
    display: none;
}

CommitList.zoomed:focus,
NoteList.zoomed:focus,
DetailPane.zoomed:focus {
    border: round $accent;
}
